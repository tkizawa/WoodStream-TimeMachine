<Window x:Class="WoodStreamTimeMachine.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="WoodStream TimeMachine"
        Width="1100" Height="750"
        MinWidth="700" MinHeight="500"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo"
        Icon="/Assets/app.ico"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- スライダーのカスタムスタイル -->
        <Style x:Key="TimelineSliderStyle" TargetType="Slider">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="8"
                                    Background="#334155"
                                    CornerRadius="4"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="8" Background="#0284C7" CornerRadius="4,0,0,4"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="20" Height="20" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Ellipse Fill="#38BDF8"
                                                         Stroke="#0284C7"
                                                         StrokeThickness="3"
                                                         Effect="{DynamicResource ShadowEffect}">
                                                    <Ellipse.Resources>
                                                        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="6" ShadowDepth="1" Opacity="0.5"/>
                                                    </Ellipse.Resources>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="8" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ボタンのスタイル -->
        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#334155"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- ヘッダーバー -->
            <RowDefinition Height="52"/>
            <!-- メイン画像ビューアーエリア -->
            <RowDefinition Height="*"/>
            <!-- タイムラインコントロールバー -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダーバー -->
        <Border Grid.Row="0"
                Background="#0B132B"
                BorderBrush="#1E293B"
                BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- アプリロゴ・タイトル -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="12" Height="12" Fill="#38BDF8" Margin="0,0,10,0"/>
                    <TextBlock x:Name="HeaderTitleTextBlock"
                               Text="WoodStream TimeMachine"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#F8FAFC"/>
                </StackPanel>

                <!-- ツールバーボタン -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OptimizeButton"
                            Style="{StaticResource ControlButtonStyle}"
                            Margin="0,0,8,0"
                            Click="OptimizeButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" Margin="0,0,6,0" Foreground="#FBBF24"/>
                            <TextBlock x:Name="OptimizeButtonText" Text="重複間引き"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="RefreshButton"
                            Style="{StaticResource ControlButtonStyle}"
                            Click="RefreshButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,6,0"/>
                            <TextBlock x:Name="RefreshButtonText" Text="更新"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- メイン画像ビューアーエリア -->
        <Grid Grid.Row="1" Background="#020617">
            <!-- キャプチャ画像表示コントロール -->
            <Image x:Name="CaptureImage"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- 画像未存在時の案内プレースホルダー -->
            <Border x:Name="EmptyStateBorder"
                    Background="#1E293B"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📷" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock x:Name="EmptyStateTextBlock"
                               Text="キャプチャ画像がありません。"
                               FontSize="15"
                               Foreground="#94A3B8"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 画面上部の日時・インデックス オーバーレイバッジ -->
            <Border x:Name="OverlayBadge"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="20"
                    Background="#CC0F172A"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🕒" Margin="0,0,8,0" Foreground="#38BDF8"/>
                        <TextBlock x:Name="TimestampOverlayTextBlock"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC"/>
                    </StackPanel>
                    <TextBlock x:Name="IndexOverlayTextBlock"
                               FontSize="12"
                               Foreground="#94A3B8"
                               Margin="24,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- 最適化/ステータス通知メッセージ -->
            <Border x:Name="StatusToast"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="20"
                    Background="#E00369A1"
                    CornerRadius="6"
                    Padding="12,8"
                    Visibility="Collapsed">
                <TextBlock x:Name="StatusToastText"
                           Foreground="#FFFFFF"
                           FontSize="13"
                           FontWeight="Medium"/>
            </Border>
        </Grid>

        <!-- タイムラインコントロールバー -->
        <Border Grid.Row="2"
                Background="#0B132B"
                BorderBrush="#1E293B"
                BorderThickness="0,1,0,0"
                Padding="20,16">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- スライダー -->
                    <RowDefinition Height="Auto"/>
                    <!-- 再生・コマ送りボタンと日時範囲 -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 横長スライダー -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Slider x:Name="TimelineSlider"
                            Style="{StaticResource TimelineSliderStyle}"
                            Minimum="0"
                            Maximum="0"
                            Value="0"
                            SmallChange="1"
                            LargeChange="5"
                            IsSnapToTickEnabled="True"
                            TickFrequency="1"
                            ValueChanged="TimelineSlider_ValueChanged"/>
                </Grid>

                <!-- コントロールボタン群と日時インジケーター -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 最古日時ラベル -->
                    <TextBlock x:Name="OldestTimeTextBlock"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#64748B"/>

                    <!-- 再生・コマ送りボタン群（中央） -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Button x:Name="PrevFrameButton"
                                Style="{StaticResource ControlButtonStyle}"
                                Width="44" Height="36"
                                Margin="0,0,8,0"
                                Click="PrevFrameButton_Click">
                            <TextBlock Text="◀" FontSize="12"/>
                        </Button>

                        <Button x:Name="PlayPauseButton"
                                Style="{StaticResource ControlButtonStyle}"
                                Width="52" Height="36"
                                Margin="0,0,8,0"
                                Click="PlayPauseButton_Click">
                            <TextBlock x:Name="PlayPauseIconText" Text="▶" FontSize="14" FontWeight="Bold"/>
                        </Button>

                        <Button x:Name="NextFrameButton"
                                Style="{StaticResource ControlButtonStyle}"
                                Width="44" Height="36"
                                Margin="0,0,8,0"
                                Click="NextFrameButton_Click">
                            <TextBlock Text="▶" FontSize="12"/>
                        </Button>
                    </StackPanel>

                    <!-- 最新日時ラベル -->
                    <TextBlock x:Name="LatestTimeTextBlock"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#64748B"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
