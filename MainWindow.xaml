<Window x:Class="WoodStreamTimeMachine.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="WoodStream TimeMachine"
        Width="1100" Height="750"
        MinWidth="700" MinHeight="500"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo"
        Icon="pack://application:,,,/Assets/app.ico"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- スライダーのカスタムスタイル -->
        <Style x:Key="TimelineSliderStyle" TargetType="Slider">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="8"
                                    Background="#334155"
                                    CornerRadius="4"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="8" Background="#0284C7" CornerRadius="4,0,0,4"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="20" Height="20" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Ellipse Fill="#38BDF8"
                                                         Stroke="#0284C7"
                                                         StrokeThickness="3"
                                                         Effect="{DynamicResource ShadowEffect}">
                                                    <Ellipse.Resources>
                                                        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="6" ShadowDepth="1" Opacity="0.5"/>
                                                    </Ellipse.Resources>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="8" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ボタンのスタイル -->
        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#334155"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- ヘッダーバー -->
            <RowDefinition Height="52"/>
            <!-- メイン画像ビューアーエリア -->
            <RowDefinition Height="*"/>
            <!-- タイムラインコントロールバー -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダーバー -->
        <Border Grid.Row="0"
                Background="#0B132B"
                BorderBrush="#1E293B"
                BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- アプリロゴ・タイトル -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="12" Height="12" Fill="#38BDF8" Margin="0,0,10,0"/>
                    <TextBlock x:Name="HeaderTitleTextBlock"
                               Text="WoodStream TimeMachine"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#F8FAFC"/>
                </StackPanel>

                <!-- ビュアー表示中のキャプチャ一時停止インジケーター -->
                <Border x:Name="CapturePausedBadge"
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="18,0,0,0"
                        Background="#26F59E0B"
                        BorderBrush="#80F59E0B"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,3">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⏸" Margin="0,0,5,0" Foreground="#FBBF24" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CapturePausedText"
                                   Text="ビュアー表示中（キャプチャ停止中）"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="#FDE68A"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ツールバーボタン & 検索バー -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 検索バー -->
                    <Border x:Name="SearchBarBorder"
                            Width="240"
                            Height="32"
                            Margin="0,0,8,0"
                            Background="#1E293B"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="SearchTextBox"
                                     Grid.Column="1"
                                     Background="Transparent"
                                     Foreground="#F8FAFC"
                                     BorderThickness="0"
                                     VerticalAlignment="Center"
                                     FontSize="12"
                                     CaretBrush="#38BDF8"
                                     KeyDown="SearchTextBox_KeyDown"
                                     TextChanged="SearchTextBox_TextChanged"/>
                            <TextBlock x:Name="SearchPlaceholderTextBlock"
                                       Grid.Column="1"
                                       Text="画面内の文字を検索 (Enter)..."
                                       Foreground="#64748B"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <Button x:Name="ClearSearchButton"
                                    Grid.Column="2"
                                    Content="✕"
                                    Width="18" Height="18"
                                    Background="Transparent"
                                    Foreground="#94A3B8"
                                    BorderThickness="0"
                                    FontSize="11"
                                    Cursor="Hand"
                                    Visibility="Collapsed"
                                    Click="ClearSearchButton_Click"/>
                        </Grid>
                    </Border>

                    <Button x:Name="SearchButton"
                            Style="{StaticResource ControlButtonStyle}"
                            Margin="0,0,8,0"
                            Click="SearchButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" Margin="0,0,4,0"/>
                            <TextBlock x:Name="SearchButtonText" Text="検索"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="OptimizeButton"
                            Style="{StaticResource ControlButtonStyle}"
                            Margin="0,0,8,0"
                            Click="OptimizeButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" Margin="0,0,6,0" Foreground="#FBBF24"/>
                            <TextBlock x:Name="OptimizeButtonText" Text="重複間引き"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="RefreshButton"
                            Style="{StaticResource ControlButtonStyle}"
                            Click="RefreshButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,6,0"/>
                            <TextBlock x:Name="RefreshButtonText" Text="更新"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- メイン画像ビューアーエリア -->
        <Grid Grid.Row="1" Background="#020617">
            <!-- キャプチャ画像表示コントロール -->
            <ScrollViewer x:Name="ImageScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="#020617"
                          CanContentScroll="False"
                          SizeChanged="ImageScrollViewer_SizeChanged">
                <Image x:Name="CaptureImage"
                       Stretch="None"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       RenderTransformOrigin="0.5,0.5"/>
            </ScrollViewer>

            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="20"
                    Background="#CC0F172A"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ZoomOutButton"
                            Width="28" Height="28"
                            Margin="0,0,8,0"
                            Style="{StaticResource ControlButtonStyle}"
                            Content="−"
                            FontSize="18"
                            FontWeight="Bold"
                            Click="ZoomOutButton_Click"/>
                    <Slider x:Name="ZoomSlider"
                            Width="170"
                            Minimum="25"
                            Maximum="400"
                            Value="100"
                            TickFrequency="5"
                            IsSnapToTickEnabled="False"
                            ValueChanged="ZoomSlider_ValueChanged"/>
                    <Button x:Name="ZoomInButton"
                            Width="28" Height="28"
                            Margin="8,0,8,0"
                            Style="{StaticResource ControlButtonStyle}"
                            Content="＋"
                            FontSize="18"
                            FontWeight="Bold"
                            Click="ZoomInButton_Click"/>
                    <Button x:Name="FitToWindowButton"
                            Style="{StaticResource ControlButtonStyle}"
                            Content="適合"
                            Click="FitToWindowButton_Click"/>
                </StackPanel>
            </Border>

            <Border x:Name="MonitorThumbnailsPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,20"
                    Background="#CC0F172A"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,8"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="モニタ切替"
                               FontSize="11"
                               Foreground="#94A3B8"
                               Margin="0,0,0,8"/>
                    <ListBox x:Name="MonitorThumbList"
                             SelectionChanged="MonitorThumbList_SelectionChanged"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="4"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ThumbBorder"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="4">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="#38BDF8"/>
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#0F172A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Image Source="{Binding Preview}"
                                           Width="120"
                                           Height="80"
                                           Stretch="UniformToFill"
                                           Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="#F8FAFC"
                                               FontSize="10"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- 画像未存在時の案内プレースホルダー -->
            <Border x:Name="EmptyStateBorder"
                    Background="#1E293B"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📷" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock x:Name="EmptyStateTextBlock"
                               Text="キャプチャ画像がありません。"
                               FontSize="15"
                               Foreground="#94A3B8"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 画面上部の日時・インデックス オーバーレイバッジ -->
            <Border x:Name="OverlayBadge"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="20"
                    Background="#CC0F172A"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🕒" Margin="0,0,8,0" Foreground="#38BDF8"/>
                        <TextBlock x:Name="TimestampOverlayTextBlock"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC"/>
                    </StackPanel>
                    <TextBlock x:Name="IndexOverlayTextBlock"
                               FontSize="12"
                               Foreground="#94A3B8"
                               Margin="24,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- 最適化/ステータス通知メッセージ -->
            <Border x:Name="StatusToast"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="20"
                    Background="#E00369A1"
                    CornerRadius="6"
                    Padding="12,8"
                    Visibility="Collapsed">
                <TextBlock x:Name="StatusToastText"
                           Foreground="#FFFFFF"
                           FontSize="13"
                           FontWeight="Medium"/>
            </Border>

            <!-- 検索結果サイドドロワーパネル -->
            <Border x:Name="SearchResultsPanel"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Width="330"
                    Background="#F00F172A"
                    BorderBrush="#1E293B"
                    BorderThickness="1,0,0,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- パネルヘッダー -->
                        <RowDefinition Height="Auto"/>
                        <!-- 検索結果リスト -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- パネルヘッダー -->
                    <Border Grid.Row="0"
                            Background="#1E293B"
                            BorderBrush="#334155"
                            BorderThickness="0,0,0,1"
                            Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="SearchPanelTitleTextBlock"
                                           Text="検索結果"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Foreground="#38BDF8"/>
                                <TextBlock x:Name="SearchResultCountTextBlock"
                                           Text="0 件見つかりました"
                                           FontSize="11"
                                           Foreground="#94A3B8"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="CloseSearchPanelButton"
                                    Grid.Column="1"
                                    Content="✕"
                                    Width="24" Height="24"
                                    Background="Transparent"
                                    Foreground="#94A3B8"
                                    BorderThickness="0"
                                    FontSize="12"
                                    Cursor="Hand"
                                    VerticalAlignment="Center"
                                    Click="CloseSearchPanelButton_Click"/>
                        </Grid>
                    </Border>

                    <!-- 検索結果一覧 -->
                    <ListBox x:Name="SearchResultsListBox"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="SearchResultsListBox_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Margin" Value="6,3"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="itemBorder"
                                                    Background="#151E2E"
                                                    BorderBrush="#1E293B"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="#1E293B"/>
                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="#38BDF8"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="#0C4A6E"/>
                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="#0284C7"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="🕒" FontSize="11" Foreground="#38BDF8" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding FormattedTimestamp}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F8FAFC"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Snippet}"
                                               FontSize="11"
                                               Foreground="#94A3B8"
                                               TextWrapping="Wrap"
                                               LineHeight="16"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 検索結果なしメッセージ -->
                    <TextBlock x:Name="NoResultsTextBlock"
                               Grid.Row="1"
                               Text="一致する画面が見つかりませんでした"
                               Foreground="#64748B"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="20"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>

        <!-- タイムラインコントロールバー -->
        <Border Grid.Row="2"
                Background="#0B132B"
                BorderBrush="#1E293B"
                BorderThickness="0,1,0,0"
                Padding="20,16">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- スライダー -->
                    <RowDefinition Height="Auto"/>
                    <!-- 再生・コマ送りボタンと日時範囲 -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 横長スライダー -->
                <Grid Grid.Row="0" Margin="0,0,0,12" SizeChanged="SliderGrid_SizeChanged">
                    <!-- 検索結果ヒット位置のインジケーターキャンバス -->
                    <Canvas x:Name="SearchTicksCanvas"
                            Height="8"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Margin="10,0"/>

                    <Slider x:Name="TimelineSlider"
                            Style="{StaticResource TimelineSliderStyle}"
                            Minimum="0"
                            Maximum="0"
                            Value="0"
                            SmallChange="1"
                            LargeChange="5"
                            IsSnapToTickEnabled="True"
                            TickFrequency="1"
                            ValueChanged="TimelineSlider_ValueChanged"/>
                </Grid>

                <!-- コントロールボタン群と日時インジケーター -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 最古日時ラベル -->
                    <TextBlock x:Name="OldestTimeTextBlock"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#64748B"/>

                    <!-- 再生・コマ送りボタン群（中央） -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Button x:Name="PrevFrameButton"
                                Style="{StaticResource ControlButtonStyle}"
                                Width="44" Height="36"
                                Margin="0,0,8,0"
                                Click="PrevFrameButton_Click">
                            <TextBlock Text="◀" FontSize="12"/>
                        </Button>

                        <Button x:Name="PlayPauseButton"
                                Style="{StaticResource ControlButtonStyle}"
                                Width="52" Height="36"
                                Margin="0,0,8,0"
                                Click="PlayPauseButton_Click">
                            <TextBlock x:Name="PlayPauseIconText" Text="▶" FontSize="14" FontWeight="Bold"/>
                        </Button>

                        <Button x:Name="NextFrameButton"
                                Style="{StaticResource ControlButtonStyle}"
                                Width="44" Height="36"
                                Margin="0,0,8,0"
                                Click="NextFrameButton_Click">
                            <TextBlock Text="▶" FontSize="12"/>
                        </Button>
                    </StackPanel>

                    <!-- 最新日時ラベル -->
                    <TextBlock x:Name="LatestTimeTextBlock"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#64748B"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
